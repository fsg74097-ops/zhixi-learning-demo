{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/SkillResponse.schema.json",
  "title": "SkillResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "enum": [
        "build_learning_profile",
        "recommend_learning_tasks"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "FAILED",
        "NEEDS_REVIEW"
      ]
    },
    "data": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "safe_fallback": {
              "type": "string",
              "minLength": 1
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "safe_fallback"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "model_metadata": {
      "type": "object"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "skill_id",
    "status",
    "data",
    "evidence_refs",
    "warnings",
    "limitations",
    "error",
    "model_metadata",
    "trace_id"
  ],
  "additionalProperties": false
}
