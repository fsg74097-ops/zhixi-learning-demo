{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/SemanticArbitration.schema.json",
  "title": "SemanticArbitration",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "arbiter_run_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "path_a_output_hash": {
      "type": "string",
      "minLength": 1
    },
    "path_b_output_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED",
        "NOT_REQUIRED"
      ]
    },
    "semantic_alignment": {
      "type": "string",
      "enum": [
        "ALIGNED",
        "PARTIALLY_ALIGNED",
        "CONFLICT",
        "INDETERMINATE",
        "NOT_REQUIRED"
      ]
    },
    "field_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "path_a_value": {
            "type": "string"
          },
          "path_b_value": {
            "type": "string"
          },
          "semantic_relation": {
            "type": "string",
            "enum": [
              "EQUIVALENT",
              "OVERLAPPING",
              "DISTINCT",
              "CONTRADICTORY",
              "NOT_COMPARABLE"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "field",
          "path_a_value",
          "path_b_value",
          "semantic_relation",
          "explanation",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_check": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "arbiter_run_id",
    "snapshot_hash",
    "path_a_output_hash",
    "path_b_output_hash",
    "status",
    "semantic_alignment",
    "field_reviews",
    "unresolved_questions",
    "recommended_next_check",
    "model_version",
    "prompt_version"
  ],
  "additionalProperties": false
}
