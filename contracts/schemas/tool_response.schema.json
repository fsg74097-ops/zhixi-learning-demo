{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/ToolResponse.schema.json",
  "title": "ToolResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "FAILED",
        "BLOCKED"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_echo": {
      "type": "object"
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "safe_fallback": {
              "type": "string",
              "minLength": 1
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "safe_fallback"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "ok",
    "status",
    "data",
    "data_version",
    "scope_echo",
    "coverage",
    "evidence",
    "warnings",
    "limitations",
    "truncated",
    "error",
    "trace_id"
  ],
  "additionalProperties": false
}
