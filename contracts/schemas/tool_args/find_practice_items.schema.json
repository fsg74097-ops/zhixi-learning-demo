{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/find_practice_items.schema.json",
  "title": "find_practice_items",
  "type": "object",
  "properties": {
    "snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "item_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "source_policy": {
      "type": "string",
      "enum": [
        "approved_practice_only"
      ]
    },
    "constraints": {
      "type": "object"
    }
  },
  "required": [
    "snapshot_hash",
    "knowledge_refs",
    "item_count",
    "source_policy",
    "constraints"
  ],
  "additionalProperties": false
}
