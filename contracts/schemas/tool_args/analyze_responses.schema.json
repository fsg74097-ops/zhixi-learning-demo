{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/analyze_responses.schema.json",
  "title": "analyze_responses",
  "type": "object",
  "properties": {
    "snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "response_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "diagnostic_goal": {
      "type": "string",
      "minLength": 1
    },
    "verification_mode": {
      "type": "string",
      "enum": [
        "AUTO",
        "A_ONLY",
        "A_AND_B"
      ]
    },
    "max_model_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "required": [
    "snapshot_hash",
    "response_refs",
    "diagnostic_goal",
    "verification_mode",
    "max_model_calls"
  ],
  "additionalProperties": false
}
