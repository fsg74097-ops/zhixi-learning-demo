{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aits.local/schemas/SkillRequest.schema.json",
  "title": "SkillRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "enum": [
        "build_learning_profile",
        "recommend_learning_tasks"
      ]
    },
    "snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object"
    },
    "locale": {
      "type": "string",
      "enum": [
        "zh-CN"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "skill_id",
    "snapshot_hash",
    "goal",
    "input_refs",
    "constraints",
    "locale",
    "trace_id"
  ],
  "additionalProperties": false
}
